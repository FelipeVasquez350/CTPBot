{
  "name": "ctp-bot",
  "description": "remake of the calamity texture pack bot",
  "version": "2.1.0",
  "main": "index.js",
  "scripts": {
    "fetch": "./fetch.sh",
    "build": "npx prisma generate && npx tsc",
    "start": "npm run fetch && node build/index.js",
    "dev": "concurrently \"tsc --watch\" \"nodemon build/index.js\"",
    "deploy": "node build/utils/deploy_commands.js",
    "withdraw": "node build/utils/withdraw_commands.js",
    "update:Windows": "git fetch && git checkout v2.0 && git add ./prisma && git commit -m \"PackDB Update to '%npm_config_var%'\" && git push origin v2.0",
    "update:Linux": "git fetch && git checkout v2.0 && git add ./prisma && git commit -m \"PackDB Update to '${npm_config_var}'\" && git push origin v2.0",
    "test": "jest",
    "migration": "npm run build && node build/utils/migrate.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/archiver": "^5.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^28.1.8",
    "@types/node": "^22.20.0",
    "concurrently": "^7.3.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.19",
    "prisma": "7.9.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "archiver": "^5.3.1",
    "ascii-table3": "^0.8.2",
    "better-sqlite3": "^12.6.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.0.1",
    "fuzzysort": "^2.0.4",
    "image-size": "^1.0.2"
  }
}
