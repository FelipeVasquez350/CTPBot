generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  runtime    = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Entity {
  name String @id
  InternalName InternalNames[]
}

model Images {
  image_id    Int       @id @default(autoincrement())
  internal_id Int      
  filename    String?
  path        String?
  status      Boolean
  last_edit   DateTime?
  user        String?
  type        String?
  width       Int?
  height      Int?
  InternalName InternalNames? @relation(fields: [internal_id], references: [internal_id])

  @@index([internal_id])
  @@index([filename])
}

model LocalizationTexts {
  localization_id    String
  localization_type  String
  localization_en_us String?
  internal_id        Int
  status      Boolean
  last_edit          DateTime?
  user               String?
  InternalName       InternalNames? @relation(fields: [internal_id], references: [internal_id])
  @@id([localization_id, localization_type])
  @@index([internal_id])
}

model Music {
  music_id     Int       @id @default(autoincrement())
  internal_id  Int
  music_title  String?
  music_volume String?
  status      Boolean
  last_edit    DateTime?
  user         String?
  InternalName InternalNames? @relation(fields: [internal_id], references: [internal_id])

  @@index([internal_id])
}

model Sounds {
  sound_id            Int       @id @default(autoincrement())
  internal_id         Int
  sound_name          String?
  sound_internal_name String?
  status      Boolean
  last_edit           DateTime?
  user                String?
  InternalName        InternalNames? @relation(fields: [internal_id], references: [internal_id])

  @@index([internal_id])
  @@index([sound_name])
}

model InternalNames {
  name          String
  internal_name String
  internal_id   Int     @id @default(autoincrement())
  Entity        Entity? @relation(fields: [name], references: [name])
  Images        Images[]
  Sounds        Sounds[]
  Music         Music[]
  LocalizationTexts LocalizationTexts[]
}

model PackInfo {
  name    String @id
  version String
}
